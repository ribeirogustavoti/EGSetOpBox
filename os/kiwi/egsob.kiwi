<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<!-- EGSetOpBox image description (Chat Master D-03, D-05, D-65, D-66, D-104, D-105). -->
<image schemaversion="7.4" name="EGSetOpBox">
	<description type="system">
		<author>ribeirogustavoti</author>
		<contact>https://github.com/ribeirogustavoti/EGSetOpBox</contact>
		<specification>EGSetOpBox: Fedora 44 for the Raspberry Pi 4B</specification>
	</description>
	<profiles>
		<profile name="Pi" description="Raspberry Pi 4B disk image (aarch64)"/>
		<profile name="VM" description="x86_64 smoke-test VM disk image (qcow2)"/>
	</profiles>
	<preferences>
		<version>0.1.0</version>
		<packagemanager>dnf5</packagemanager>
		<locale>en_US</locale>
		<keytable>us</keytable>
		<timezone>Europe/Brussels</timezone>
		<release-version>44</release-version>
	</preferences>
	<preferences profiles="Pi" arch="aarch64">
		<type image="oem"
		      filesystem="btrfs" btrfs_root_is_subvolume="true" btrfs_set_default_volume="false" fsmountoptions="x-systemd.growfs,compress=zstd:1"
		      kernelcmdline="console=tty1 quiet" devicepersistency="by-uuid" force_mbr="true" editbootinstall="editbootinstall_rpi.sh"
		      bootpartition="true" bootpartsize="2000" bootfilesystem="ext4" efipartsize="500" disk_start_sector="34816" firmware="uefi"
		      rootfs_label="fedora"
		      >
			<bootloader name="grub2" bls="true" console="console" timeout="5"/>
			<systemdisk name="fedora">
				<volume name="@root=root"/>
				<volume name="home" parent="/"/>
				<volume name="var" parent="/"/>
			</systemdisk>
			<oemconfig>
				<oem-resize>false</oem-resize>
			</oemconfig>
		</type>
	</preferences>
	<preferences profiles="VM" arch="x86_64">
		<type image="oem" format="qcow2"
		      filesystem="btrfs" btrfs_root_is_subvolume="true" btrfs_set_default_volume="false" fsmountoptions="x-systemd.growfs,compress=zstd:1"
		      kernelcmdline="console=tty1 console=ttyS0,115200n8" devicepersistency="by-uuid"
		      bootpartition="true" bootpartsize="2000" bootfilesystem="ext4" efipartsize="500" firmware="uefi"
		      rootfs_label="fedora"
		      >
			<bootloader name="grub2" bls="true" console="console" timeout="5"/>
			<size unit="G">12</size>
			<systemdisk name="fedora">
				<volume name="@root=root"/>
				<volume name="home" parent="/"/>
				<volume name="var" parent="/"/>
			</systemdisk>
			<oemconfig>
				<oem-resize>false</oem-resize>
			</oemconfig>
		</type>
	</preferences>
	<repository type="rpm-md" alias="fedora" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="updates" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<packages type="bootstrap">
		<package name="filesystem"/>
		<package name="fedora-release"/>
		<package name="grubby"/>
	</packages>
	<packages type="image" patternType="plusRecommended">
		<namedCollection name="core"/>
		<namedCollection name="networkmanager-submodules"/>
		<namedCollection name="hardware-support"/>
		<ignore name="kernel-*debug*"/>
		<ignore name="initial-setup-gui"/>
		<ignore name="plymouth"/>
		<package name="kernel"/>
		<package name="kernel-modules"/>
		<package name="kernel-modules-extra"/>
		<package name="btrfs-progs"/>
		<package name="glibc-langpack-en"/>
		<package name="initial-setup"/>
		<package name="openssh-server"/>
		<package name="NetworkManager-wifi"/>
		<package name="sudo"/>
		<package name="mesa-dri-drivers"/>
		<package name="mesa-libEGL"/>
		<package name="mesa-libgbm"/>
		<package name="libinput"/>
		<package name="libseat"/>
		<package name="libxkbcommon"/>
		<package name="fontconfig"/>
		<package name="dejavu-sans-fonts"/>
		<package name="grub2-efi-aa64" arch="aarch64"/>
		<package name="grub2-efi-aa64-modules" arch="aarch64"/>
		<package name="shim-signed-aa64" arch="aarch64"/>
		<package name="bcm283x-firmware" arch="aarch64"/>
		<package name="uboot-images-armv8" arch="aarch64"/>
		<package name="grub2-efi-x64" arch="x86_64"/>
		<package name="grub2-efi-x64-modules" arch="x86_64"/>
		<package name="shim-signed-x64" arch="x86_64"/>
	</packages>
	<packages type="image" patternType="plusRecommended" profiles="VM">
		<package name="kernel-modules-internal"/>
		<package name="v4l-utils"/>
	</packages>
</image>
