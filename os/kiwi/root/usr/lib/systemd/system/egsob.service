[Unit]
Description=EGSetOpBox TV interface on tty1
After=systemd-user-sessions.service initial-setup.service mnt-egsob.mount
Conflicts=getty@tty1.service
ConditionPathExists=/usr/bin/egsob

[Service]
User=egsob
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
StateDirectory=egsob
Environment=EGSOB_UI=1
ExecStart=/usr/bin/egsob
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
